#!/bin/bash
# Generates the host unlock identity and seals it to this machine's TPM, for iron-vault.service's handoff unit
# (design/tpm-unlock.md, "Provisioning"). Run once, as root. See iron-vault-provision-host-unlock(8).
#
# The secret text exists only in pipes: it is never a file, an argument or an environment variable. Only the recipient
# key, `age1...`, is printed, to enrol with `iron-vault init --host-unlock` or `iron-vault recipient add --host-unlock`.
#
# It never clears the TPM, takes ownership, sets hierarchy authorization or changes dictionary-attack parameters:
# `systemd-creds` seals under systemd's own storage root key, and nothing else here touches the TPM.
#
# usage: iron-vault-provision-host-unlock --server [--accept-physical-access] | --portable [--accept-no-second-secret]

# Fixed paths. They are plain assignments, not read from the environment, so no caller of this root script can move
# them; the stub test reassigns them after sourcing the file.
HOST_DIR=/etc/iron-vault-host
OS_RELEASE=/etc/os-release
SYS_ROOT=/sys
DEV_ROOT=/dev
CRYPTTAB=/etc/crypttab
BOOT_DIR=/boot

# TPM unlock is supported on this release only (design/tpm-unlock.md, "Supported releases").
SUPPORTED_ID=ubuntu
SUPPORTED_VERSION_ID=24.04
SUPPORTED_NAME="Ubuntu 24.04 LTS"

MODE=
ACCEPT_PHYSICAL_ACCESS=0
ACCEPT_NO_SECOND_SECRET=0

# Filled by the --portable checks, one entry per warning, and read by the acceptance prompt and the record.
WARNINGS=()
# The UUID under which clevis stores its binding in a LUKS1 header's luksmeta.
CLEVIS_UUID=cb6e8904-81ff-40da-a84a-07ab9ab5715e
# Whether some systemd-tpm2 token needs no PIN; the crypttab check reads it.
PINLESS_TPM=0
# How the administrator accepted: terminal, flag, or "not needed (no warning)".
ACCEPTED_BY=
RISK="Without a pre-boot secret, anyone who steals this machine can boot it and start the vault."

die() {
    echo "error: $*" >&2
    exit 1
}

usage() {
    echo "usage: iron-vault-provision-host-unlock --server [--accept-physical-access] | --portable [--accept-no-second-secret]" >&2
    exit 2
}

# Exactly one mode, with no default, so the administrator chooses which §14 condition the machine meets.
parse_args() {
    local arg
    for arg in "$@"; do
        case $arg in
            --server | --portable) [ -z "$MODE" ] || usage; MODE=${arg#--} ;;
            --accept-physical-access) ACCEPT_PHYSICAL_ACCESS=1 ;;
            --accept-no-second-secret) ACCEPT_NO_SECOND_SECRET=1 ;;
            *) usage ;;
        esac
    done
    [ -n "$MODE" ] || usage
    [ "$ACCEPT_PHYSICAL_ACCESS" = 0 ] || [ "$MODE" = server ] || usage
    [ "$ACCEPT_NO_SECOND_SECRET" = 0 ] || [ "$MODE" = portable ] || usage
}

# Prints one field of os-release, unquoted. The file is read, never sourced, so nothing in it runs as root.
os_release_field() {
    sed -n "s/^$1=//p" "$OS_RELEASE" 2>/dev/null | head -n 1 | tr -d "\"'"
}

check_release() {
    [ "$(os_release_field ID)" = "$SUPPORTED_ID" ] && [ "$(os_release_field VERSION_ID)" = "$SUPPORTED_VERSION_ID" ] && return
    local found
    found=$(os_release_field PRETTY_NAME)
    die "TPM unlock is supported on $SUPPORTED_NAME only; this machine runs ${found:-an unknown release}." \
        "The service still starts Locked and waits for 'iron-vault unlock'."
}

check_host() {
    [ "$(id -u)" -eq 0 ] || die "run as root"
    check_release
    local tool
    for tool in age-keygen systemd-creds logger; do
        command -v "$tool" >/dev/null || die "$tool is not installed"
    done
}

have_tool() { command -v "$1" >/dev/null; }

add_warning() { WARNINGS+=("$*"); }

# --- --portable: is there a pre-boot secret? (design/tpm-unlock.md, "--portable") ---
# Every check appends to WARNINGS and takes its input as arguments, so the stub test feeds it text and a fake sysfs. A
# check that cannot run adds a warning; nothing here ever passes by default.

# host_mount_field FIELD: findmnt's FIELD (SOURCE, FSTYPE, UUID) for HOST_DIR, or its nearest existing parent.
host_mount_field() {
    local dir=$HOST_DIR
    [ -d "$dir" ] || dir=$(dirname "$dir")
    findmnt -n -o "$1" -T "$dir" 2>/dev/null
}

# Prints the kernel name (dm-0, nvme0n1p3) of the block device that holds HOST_DIR, or its nearest existing parent.
# findmnt names only one device, so a filesystem that can span several is walked by host_stack_records instead.
host_block_device() {
    local src
    src=$(host_mount_field SOURCE) || return 1
    src=${src%%\[*}
    case $src in /dev/*) ;; *) return 1 ;; esac
    basename "$(readlink -f "$src" 2>/dev/null || echo "$src")"
}

# fs_members SYSROOT FSTYPE UUID: prints the kernel name of each block device of a btrfs or bcachefs filesystem, one per line
# and in the namespace of class/block. It fails when the list cannot be read or is empty. UUID comes from findmnt, so it is
# checked before it is put in a path.
#   btrfs:    the entries of /sys/fs/btrfs/UUID/devices/, each named for its device (dm-0, sdb1).
#   bcachefs: /sys/fs/bcachefs/UUID/dev-N/block, a symlink the kernel makes to each member's block device; its target's
#             last component is the name. This is from the kernel's bcachefs sysfs code and is unchecked on a real
#             multi-device filesystem, so any member whose link cannot be read fails the whole list: a guess is a false pass.
fs_members() {
    local sys=$1 fs=$2 uuid=$3 dir entry target
    case $uuid in '' | *[!0-9a-fA-F-]*) return 1 ;; esac
    case $fs in
        btrfs) ls -1 "$sys/fs/btrfs/$uuid/devices" 2>/dev/null ;;
        bcachefs)
            dir=$sys/fs/bcachefs/$uuid
            [ -d "$dir" ] || return 1
            for entry in "$dir"/dev-*; do
                [ -d "$entry" ] || return 1
                target=$(readlink "$entry/block" 2>/dev/null) && [ -n "$target" ] || return 1
                basename "$target"
            done ;;
        *) return 1 ;;
    esac
}

# walk_filesystem SYSROOT FSTYPE UUID: walk_stack from every member of a multi-device filesystem, each judged on its own.
# When the members cannot be listed it prints `members FSTYPE`, never a walk of the one device findmnt knows. Members that
# share a LUKS layer print the same record, so a repeat is dropped (in order) lest its warnings are said twice.
walk_filesystem() {
    local members member
    if ! members=$(fs_members "$1" "$2" "$3") || [ -z "$members" ]; then printf 'members\t%s\n' "$2"; return 0; fi
    while read -r member; do walk_stack "$1" "$member"; done <<<"$members" | awk '!seen[$0]++'
}

# host_stack_records: the walk_stack records for everything that holds HOST_DIR.
host_stack_records() {
    local fstype uuid dev
    fstype=$(host_mount_field FSTYPE) || fstype=
    case $fstype in
        btrfs | bcachefs)
            uuid=$(host_mount_field UUID) || uuid=
            walk_filesystem "$SYS_ROOT" "$fstype" "$uuid" ;;
        *)
            if dev=$(host_block_device); then walk_stack "$SYS_ROOT" "$dev"; else printf 'unresolved\t%s\n' "$HOST_DIR"; fi ;;
    esac
}

# partition_parent NODE: prints the name of the disk a partition sits on. A partition has no slaves of its own, so a partition
# of an md or device-mapper device is walked as that device; sysfs links class/block/md0p1 to .../md0/md0p1.
partition_parent() {
    [ -e "$1/partition" ] && basename "$(dirname "$(readlink -f "$1")")"
}

# walk_stack SYSROOT DEVICE [DEPTH [UNDER_CRYPT]]: walks device-mapper's slaves downwards and prints a tab-separated record
# per layer: `luks MAPNAME BACKING`, `crypt MAPNAME` (dm-crypt with no LUKS header), `plain DEVICE` (a device with nothing
# below it, reached with no dm-crypt layer above it on that path) or `unresolved DEVICE`. UNDER_CRYPT is 1 once the walk
# has passed a dm-crypt layer, so each path is judged on its own: an LV over a LUKS PV and a plain PV yields a `plain`.
# The walk uses class/block, which lists partitions as well as the /sys/block disks. A partition whose parent has slaves
# (an md or device-mapper partition) is walked as the parent.
walk_stack() {
    local sys=$1 dev=$2 depth=${3:-0} under=${4:-0}
    local node=$1/class/block/$2 uuid name slaves slave parent
    if [ ! -d "$node" ] || [ "$depth" -gt 16 ]; then printf 'unresolved\t%s\n' "$dev"; return 0; fi
    if parent=$(partition_parent "$node") && [ -n "$(ls -A "$1/class/block/$parent/slaves" 2>/dev/null)" ]; then
        walk_stack "$sys" "$parent" $((depth + 1)) "$under"
        return 0
    fi
    uuid=$(cat "$node/dm/uuid" 2>/dev/null) || uuid=
    name=$(cat "$node/dm/name" 2>/dev/null) || name=$dev
    slaves=$(ls -1 "$node/slaves" 2>/dev/null) || slaves=
    case $uuid in
        CRYPT-LUKS*)
            under=1
            if [ -n "$slaves" ]; then awk -v n="$name" '{ printf "luks\t%s\t%s\n", n, $0 }' <<<"$slaves"
            else printf 'unresolved\t%s\n' "$dev"; fi ;;
        CRYPT-*) under=1; printf 'crypt\t%s\n' "$name" ;;
    esac
    if [ -n "$slaves" ]; then while read -r slave; do walk_stack "$sys" "$slave" $((depth + 1)) "$under"; done <<<"$slaves"
    elif [ "$under" = 0 ]; then printf 'plain\t%s\n' "$dev"; fi
}

# stack_warnings RECORDS: warns for an unresolved layer, a dm-crypt layer with no LUKS header to read, or any path that
# reaches a device with no dm-crypt layer above it, or a multi-device filesystem whose members could not be listed.
stack_warnings() {
    local kind rest
    while IFS=$'\t' read -r kind rest; do
        case $kind in
            crypt)
                add_warning "$rest is plain dm-crypt, which has no LUKS header to read, so its key was not checked. $RISK" \
                    "Fix: use LUKS with a passphrase or a TPM slot that needs a PIN." ;;
            plain)
                add_warning "$rest, under $HOST_DIR, has no dm-crypt layer above it: that part of the disk is not encrypted. $RISK" \
                    "Fix: encrypt the disk (every device the filesystem uses), then run this again." ;;
            members)
                add_warning "could not list the devices of the $rest filesystem under $HOST_DIR, so its encryption was not checked." \
                    "$RISK Fix: mount /sys so the filesystem's member list is readable and run this again; if it stays unreadable," \
                    "check by hand that every device of the filesystem is encrypted before accepting this warning." ;;
            unresolved)
                add_warning "could not resolve the device stack under $HOST_DIR (at $rest), so its encryption was not checked." \
                    "$RISK Fix: encrypt the disk with LUKS, then run this again." ;;
        esac
    done <<<"$1"
}

# tpm_tokens DUMP: prints "TYPE PIN" for each token of a luksDump (LUKS2). PIN is the value of tpm2-pin, empty when the
# token does not print one, as when cryptsetup lacks systemd's token plugin.
tpm_tokens() {
    awk '
        function flush() { if (have) print type, pin; have = 0 }
        /^Tokens:/ { in_t = 1; next }
        /^[^[:space:]]/ { flush(); in_t = 0 }
        in_t && /^[[:space:]]+[0-9]+:[[:space:]]/ { flush(); type = $2; pin = ""; have = 1; next }
        in_t && /tpm2-pin:/ { pin = $2 }
        END { flush() }' <<<"$1"
}

# luks1_warnings DEVICE: a LUKS1 header has no tokens; clevis records its binding in luksmeta, under its own UUID. luksmeta show
# prints one `SLOT active|inactive ...` line per key slot, so output with no such line checked nothing. A volume that never had
# clevis bound has no luksmeta area, and luksmeta show then fails with "Device is not initialized": that is the one failure that
# means no binding exists, so the warning says it may be accepted. Its stderr is not matched to hide the warning, because
# a failure the helper cannot tell from that one must stay a warning.
luks1_warnings() {
    local dev=$1 meta
    if ! have_tool luksmeta; then
        add_warning "$dev is LUKS1 and luksmeta is not installed, so its clevis bindings were not checked. $RISK" \
            "Fix: install luksmeta and run this again."
    elif ! meta=$(luksmeta show -d "$dev" 2>/dev/null); then
        add_warning "luksmeta show -d $dev failed, so the clevis bindings of this LUKS1 volume were not checked. $RISK" \
            "Fix: run luksmeta show -d $dev as root to read why, then run this again. If it says \"Device is not initialized\", no" \
            "clevis binding exists on this volume and you can accept this warning. Do not initialize luksmeta to clear it:" \
            "that writes to the LUKS header."
    elif ! grep -Eq '^[0-9]+ +(active|inactive)' <<<"$meta"; then
        add_warning "luksmeta show -d $dev listed no key slots, so the clevis bindings of this LUKS1 volume were not checked. $RISK" \
            "Fix: run luksmeta show -d $dev as root to see its output, then run this again."
    elif grep -qi "$CLEVIS_UUID" <<<"$meta"; then
        add_warning "$dev is LUKS1 with a clevis binding, which asks for nothing at boot. $RISK" \
            "Fix: remove it with clevis luks unbind, and use a passphrase or LUKS2 with systemd-cryptenroll --tpm2-with-pin=yes."
    fi
}

# luks_token_warnings DEVICE DUMP: warns for each LUKS2 token that opens the volume without a person present. Only a
# systemd-tpm2 token that prints `tpm2-pin: true` counts as needing a PIN; FIDO2 and PKCS#11 tokens need a device the
# person holds, and any other type is one the helper cannot judge.
luks_token_warnings() {
    local dev=$1 type pin
    while read -r type pin; do
        case $type in
            systemd-tpm2)
                [ "$pin" = true ] && continue
                PINLESS_TPM=1
                add_warning "$dev has a systemd-tpm2 token that does not need a PIN (tpm2-pin is '${pin:-not shown}'). $RISK" \
                    "Fix: systemd-cryptenroll --wipe-slot=tpm2 --tpm2-device=auto --tpm2-with-pin=yes $dev (changes the key slot, not the data)." ;;
            clevis)
                add_warning "$dev has a clevis token, which asks for nothing at boot. $RISK" \
                    "Fix: remove it with clevis luks unbind and use systemd-cryptenroll --tpm2-with-pin=yes (changes the key slot, not the data)." ;;
            systemd-fido2 | systemd-pkcs11) ;;
            *)
                add_warning "$dev has a $type token, which the helper does not recognise, so whether it needs a person was not checked." \
                    "$RISK Fix: remove the token; passphrase, FIDO2, PKCS#11 and TPM PIN slots are recognised." ;;
        esac
    done < <(tpm_tokens "$2")
}

# luks_dump_warnings DEVICE DUMP: dispatches on the header version.
luks_dump_warnings() {
    case $(awk '/^Version:/ { print $2; exit }' <<<"$2") in
        1) luks1_warnings "$1" ;;
        2) luks_token_warnings "$1" "$2" ;;
        *) add_warning "cryptsetup luksDump $1 printed nothing the helper recognises, so its key slots were not checked. $RISK" \
            "Fix: run cryptsetup luksDump $1 as root to see why, then run this again." ;;
    esac
}

# luks_layer_warnings BACKING: reads the LUKS header on BACKING, a kernel name.
luks_layer_warnings() {
    local dev=$DEV_ROOT/$1 dump
    if ! have_tool cryptsetup; then
        add_warning "cryptsetup is not installed, so the key slots of $dev were not checked. $RISK" \
            "Fix: install cryptsetup and run this again."
    elif ! dump=$(cryptsetup luksDump "$dev" 2>/dev/null); then
        add_warning "cryptsetup luksDump $dev failed, so its key slots were not checked. $RISK" \
            "Fix: run cryptsetup luksDump $dev as root to see why (a detached header is not supported), then run this again."
    else
        luks_dump_warnings "$dev" "$dump"
    fi
}

# crypttab_warnings TEXT NAME: warns when the entry named NAME has a key file, or tpm2-device= beside a PIN-less token. No
# entry for a LUKS layer is a warning too, because the check then saw nothing.
crypttab_warnings() {
    local text=$1 name=$2 key opts seen=0
    while read -r _ _ key opts _; do
        seen=1
        case ${key:-none} in
            none | -) ;;
            *) add_warning "$CRYPTTAB opens $name with the key file $key. $RISK Fix: remove the key file and use a passphrase or a TPM PIN." ;;
        esac
        if [ "$PINLESS_TPM" = 1 ] && [[ ,$opts, == *,tpm2-device=* ]]; then
            add_warning "$CRYPTTAB opens $name with tpm2-device= while a systemd-tpm2 token needs no PIN. $RISK" \
                "Fix: re-enrol the slot with systemd-cryptenroll --tpm2-with-pin=yes (changes the key slot, not the data)."
        fi
    done < <(awk -v n="$name" '$1 == n' <<<"$text")
    [ "$seen" = 1 ] || add_warning "$CRYPTTAB has no entry named $name, so its key file option was not checked. $RISK" \
        "Fix: add an entry named $name to $CRYPTTAB, then run this again."
}

# initramfs_warnings IMAGE LISTING: initramfs-tools puts a key file under cryptroot/keyfiles/.
initramfs_warnings() {
    if grep -q 'cryptroot/keyfiles/.' <<<"$2"; then
        add_warning "$1 holds a key file, so the disk opens with no person present. $RISK" \
            "Fix: remove the key file and its KEYFILE_PATTERN, then run update-initramfs -u -k all."
    fi
}

# check_image IMAGE: a listing that cannot be read, or is empty, checked nothing.
check_image() {
    local listing
    if ! listing=$(lsinitramfs "$1" 2>/dev/null); then
        add_warning "lsinitramfs could not list $1, so it was not checked for a key file. $RISK" \
            "Fix: run lsinitramfs $1 as root to see why, then run this again."
    elif [ -z "$listing" ]; then
        add_warning "lsinitramfs listed nothing for $1, so it was not checked for a key file. $RISK" \
            "Fix: run update-initramfs -u -k all, then run this again."
    else initramfs_warnings "$1" "$listing"; fi
}

# check_initramfs: every /boot/initrd.img-*, because a kernel update rebuilds them.
check_initramfs() {
    local images=("$BOOT_DIR"/initrd.img-*) image
    if ! have_tool lsinitramfs; then
        add_warning "lsinitramfs is not installed, so the initramfs images were not checked for a key file. $RISK" \
            "Fix: install initramfs-tools-core and run this again."
    elif [ ! -e "${images[0]}" ]; then
        add_warning "no $BOOT_DIR/initrd.img-* was found, so no initramfs was checked for a key file. $RISK" \
            "Fix: run update-initramfs -u -k all, then run this again."
    else
        # A for loop, not a pipe into while: a subshell would lose the warnings.
        for image in "${images[@]}"; do check_image "$image"; done
    fi
}

# check_portable: fills WARNINGS; empty means every check ran and passed.
check_portable() {
    local records kind name backing text names=()
    WARNINGS=()
    PINLESS_TPM=0
    records=$(host_stack_records)
    stack_warnings "$records"
    while IFS=$'\t' read -r kind name backing; do
        [ "$kind" = luks ] || continue
        names+=("$name")
        luks_layer_warnings "$backing"
    done <<<"$records"
    if [ ${#names[@]} -gt 0 ]; then
        if text=$(cat "$CRYPTTAB" 2>/dev/null); then
            while read -r name; do crypttab_warnings "$text" "$name"; done < <(printf '%s\n' "${names[@]}" | sort -u)
        else
            add_warning "$CRYPTTAB could not be read, so its key file options were not checked. $RISK" \
                "Fix: make $CRYPTTAB readable by root and run this again."
        fi
    fi
    check_initramfs
}

# accept_risk GIVEN FLAG: at a terminal the administrator always types the answer; the flag only lets a run with no
# terminal past. The answer is never read from a pipe, so `yes |` cannot accept for anyone. Sets ACCEPTED_BY.
accept_risk() {
    if [ -t 0 ]; then
        local answer=
        printf 'Type yes to accept: ' >&2
        read -r answer || true
        [ "$answer" = yes ] || die "not accepted; nothing was sealed"
        ACCEPTED_BY=terminal
    elif [ "$1" = 1 ]; then
        echo "accepted with $2" >&2
        ACCEPTED_BY=flag
    else
        die "stdin is not a terminal; run this at a terminal and type yes, or pass $2"
    fi
}

# §14: a server may unlock unattended only if its deployment accepts this.
confirm_server() {
    cat >&2 <<'TEXT'
--server: this machine will unlock its vault at every boot with no one present.
Anyone with physical access to it and a trusted boot image can start the vault and use its credentials.
Choose --server only for a server or appliance whose deployment accepts that.
TEXT
    accept_risk "$ACCEPT_PHYSICAL_ACCESS" --accept-physical-access
}

# §14: with any warning, nothing is sealed until the administrator accepts that no second secret protects the disk.
confirm_portable() {
    if [ ${#WARNINGS[@]} -eq 0 ]; then ACCEPTED_BY="not needed (no warning)"; return 0; fi
    printf 'warning: %s\n' "${WARNINGS[@]}" >&2
    echo "--portable: the checks above found no pre-boot secret, or could not find one. Nothing is sealed until you accept that." >&2
    accept_risk "$ACCEPT_NO_SECOND_SECRET" --accept-no-second-secret
}

# --- the acceptance record (design/tpm-unlock.md, "The acceptance record"), written before sealing ---

record_lines() {
    {
        echo "mode: $MODE"
        [ ${#WARNINGS[@]} -eq 0 ] || printf 'warning: %s\n' "${WARNINGS[@]}"
        echo "accepted: $ACCEPTED_BY"
        echo "sudo-user: ${SUDO_USER:-none}"
    } | tr -cd '[:print:]\n'
}

# log_record LINES: one journal entry per line, auth.warning when a warning was accepted.
log_record() {
    local priority=auth.notice line
    [ ${#WARNINGS[@]} -eq 0 ] || priority=auth.warning
    while IFS= read -r line; do
        logger -t iron-vault-host-unlock -p "$priority" -- "$line" || die "could not write the journal record; nothing was sealed"
    done <<<"$1"
}

# provisioning_file LINES: replaced whole at each provisioning, by renaming a temp file in the same root-only directory.
provisioning_file() {
    local tmp stamp
    stamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    tmp=$(mktemp "$HOST_DIR/.provisioning.txt.XXXXXX") || die "could not write $HOST_DIR/provisioning.txt; nothing was sealed"
    if ! { awk -v t="$stamp" '{ print t, $0 }' <<<"$1" >"$tmp" && chmod 0600 "$tmp" && mv -fT "$tmp" "$HOST_DIR/provisioning.txt"; }; then
        rm -f "$tmp"
        die "could not write $HOST_DIR/provisioning.txt; nothing was sealed"
    fi
}

record_acceptance() {
    local lines
    lines=$(record_lines)
    log_record "$lines"
    provisioning_file "$lines"
}

prepare_host_dir() {
    umask 077
    install -d -m 0700 -o root -g root "$HOST_DIR"
}

# Seals a fresh identity to PCR 7. grep drops age-keygen's comment lines, and the process substitution derives the
# recipient key from the same pipe. A failed seal removes what it wrote, so a partial blob is never mistaken for a
# real one by the existence check.
seal() {
    local cred=$1
    umask 077
    if ! age-keygen 2>/dev/null \
        | grep '^AGE-SECRET-KEY-1' \
        | tee >(age-keygen -y >&2) \
        | systemd-creds encrypt --with-key=tpm2 --tpm2-pcrs=7 --name=host-unlock - "$cred"; then
        rm -f "$cred"
        die "sealing failed; nothing was kept"
    fi
    chmod 0600 "$cred"
    echo "sealed $cred (--with-key=tpm2, PCR 7); enrol the recipient key printed above" >&2
}

main() {
    set -euo pipefail
    parse_args "$@"
    check_host
    local cred=$HOST_DIR/host-unlock.cred
    if [ -e "$cred" ] || [ -L "$cred" ]; then
        die "$cred exists; move it aside first, then enrol the new identity"
    fi
    case $MODE in
        portable) check_portable; confirm_portable ;;
        server) confirm_server ;;
    esac
    prepare_host_dir
    record_acceptance
    seal "$cred"
}

# Sourcing the file (to test it) defines the functions and runs nothing.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then main "$@"; fi
