#!/bin/sh
# SPDX-License-Identifier: MPL-2.0
# Purge deletes what the service wrote outside dpkg's knowledge: /etc/iron-vault, /var/log/iron-vault and the listener
# drop-ins. It deletes the vault, and with it the host unlock blob in /etc/iron-vault-host, only if the owner answers
# yes to the debconf question, asked now as mariadb-server does; no answer, a non-interactive purge or a missing
# debconf keeps both. Messages go to stderr (see postinst).
set -e

# shellcheck source=/dev/null
[ "$1" = purge ] && [ -e /usr/share/debconf/confmodule ] && . /usr/share/debconf/confmodule

vault=/var/lib/iron-vault

# Whether the owner said to delete the vault; false when the question cannot be asked.
delete_vault_requested() {
    command -v db_input >/dev/null 2>&1 || return 1
    db_input high iron-vault/purge_vault || true
    db_go || true
    RET=false
    db_get iron-vault/purge_vault || true
    [ "$RET" = true ]
}

purge_vault_question() {
    [ -d "$vault" ] || return 0
    if delete_vault_requested; then
        rm -rf "$vault"
        # The host unlock identity opens only this vault, so it goes with it. A kept vault needs it again.
        rm -rf /etc/iron-vault-host
    else
        echo "iron-vault: kept $vault, which holds the encrypted credentials." >&2
        echo "iron-vault: to delete it: sudo rm -rf $vault" >&2
    fi
}

if [ "$1" = purge ]; then
    rm -rf /etc/iron-vault /var/log/iron-vault
    # Globs expand to nothing when no drop-in exists, and rm -f ignores the literal pattern.
    rm -rf /etc/systemd/system/iron-vault-listener@*.socket.d
    purge_vault_question
    if command -v db_purge >/dev/null 2>&1; then
        db_purge || true
    fi
fi

#DEBHELPER#

# The TPM signing helper's socket, as dh_installsystemd handles a unit: remove masks it, so a removed package cannot be started by
# name, and purge forgets its state and unmasks it. Neither touches the iron-vault-tpm account, which stays as iron-vault does.
tpm_socket=iron-vault-tpm-signer.socket
if [ "$1" = remove ] && [ -x /usr/bin/deb-systemd-helper ]; then
    deb-systemd-helper mask "$tpm_socket" >/dev/null || true
fi
if [ "$1" = purge ] && [ -x /usr/bin/deb-systemd-helper ]; then
    deb-systemd-helper purge "$tpm_socket" >/dev/null || true
    deb-systemd-helper unmask "$tpm_socket" >/dev/null || true
fi

exit 0
