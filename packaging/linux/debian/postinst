#!/bin/sh
# The snippets cargo-deb generates (the debhelper token below) create the service account and its directories (sysusers.d and
# tmpfiles.d), reload systemd, and enable and start iron-vault.service, or restart it on an upgrade. No listener socket
# unit is enabled: the administrator creates those. Messages go to stderr because debconf's confmodule owns stdout.
set -e

# Registers the purge question's template with debconf; the question itself is asked by postrm.
[ -e /usr/share/debconf/confmodule ] && . /usr/share/debconf/confmodule

# The generated snippets create the account and directories before they enable and start the service.
#DEBHELPER#

if [ "$1" = configure ]; then
    if [ -z "$2" ]; then
        next="sudo iron-vault init"
    else
        next="sudo iron-vault unlock"
    fi
    echo "iron-vault: the service is Locked until you run '$next'." >&2
fi

exit 0
