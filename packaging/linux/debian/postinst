#!/bin/sh
# SPDX-License-Identifier: MPL-2.0
# The snippets cargo-deb generates (the debhelper token below) create the service account and its directories (sysusers.d and
# tmpfiles.d), reload systemd, and enable and start iron-vault.service, or restart it on an upgrade. No listener socket
# unit is enabled: the administrator creates those. Messages go to stderr because debconf's confmodule owns stdout.
set -e

# BEGIN service account check. crates/iron-vault/tests/service/package_account_check.rs runs this block against fixture files.

# systemd-sysusers leaves an existing iron-vault account or group as it is, and the package would then hand that account
# the service's directories and that group the audit log. Prints one line per way an existing account or group differs
# from the locked system account sysusers creates, and nothing when neither exists; fails only when a file is unreadable.
# Reads $passwd_file, $group_file, $shadow_file, $gshadow_file and $login_defs. A missing gshadow file means no group has a
# gshadow entry; one that exists but cannot be read fails the function.
service_account_problems() {
    sys_uid_max=$(awk '$1 == "SYS_UID_MAX" { v = $2 } END { print v }' "$login_defs" 2>/dev/null || true)
    case "$sys_uid_max" in '' | *[!0-9]*) sys_uid_max=999 ;; esac
    set -- "$passwd_file" "$group_file" "$shadow_file"
    [ ! -e "$gshadow_file" ] || set -- "$@" "$gshadow_file"
    awk -F: -v name=iron-vault -v max="$sys_uid_max" \
        -v passwd="$passwd_file" -v group="$group_file" -v shadow="$shadow_file" -v gshadow="$gshadow_file" '
        # The first entry is the one getpwnam and getgrnam return.
        FILENAME == passwd && $1 == name && !user { user = 1; pw = $2; uid = $3; gid = $4; home = $6; shell = $7; next }
        FILENAME == passwd { users++; pname[users] = $1; puid[users] = $3; pgid[users] = $4 }
        FILENAME == group && $1 == name && !grp { grp = 1; gpw_group = $2; ggid = $3; members = $4; next }
        # glibc skips blanks before each member name, so " iron-vault" in a member list is a member too.
        FILENAME == group {
            groups++; gname[groups] = $1; ggidof[groups] = $3
            m = "," $4; gsub(/,[ \t]+/, ",", m); gmembers[groups] = m ","
        }
        FILENAME == shadow && $1 == name && !shadowed { shadowed = 1; spw = $2 }
        # gshadow(5): name:password:administrators:members. A password starting with ! or * is not a valid crypt(3) string,
        # so no one can join the group with it; an empty one lets no non-member in either.
        # Every line is read, as gpasswd skips a malformed one and may act on a later one.
        # getsgnam (newgrp) scans with shadow-utils lib/gshadow.c: sgetsgent rejects a line unless it has exactly 4 fields,
        # and getsgent returns NULL at the first line it rejects, which ends the scan. So the entry newgrp finds is the
        # first iron-vault line with NF == 4 and no malformed line (blank, bare name, 5 fields) before it. fgetsx
        # (lib/fputsx.c) also joins a line ending in a backslash to the next one before sgetsgent counts fields, so such a
        # line hides the lines after it too (the joined line has too many fields). Without an entry,
        # newgrp falls back to the /etc/group password, so this must not count a line it would not find.
        FILENAME == gshadow && !scanned {
            if (NF != 4 || /\\$/) scanned = 1
            else if ($1 == name) { gshadowed = 1; scanned = 1 }
        }
        FILENAME == gshadow && $1 == name {
            if ($2 != "" && $2 !~ /^[!*]/) gpw = 1
            if ($3 != "") gadmins = gadmins (gadmins == "" ? "" : ",") $3
            if ($4 != "") gmembers_sh = gmembers_sh (gmembers_sh == "" ? "" : ",") $4
        }
        END {
            if (user) {
                if (uid !~ /^[0-9]+$/ || uid == 0 || uid + 0 > max)
                    print("account " name ": uid " uid " is not a system uid (1 to " max ")")
                if (shell !~ /^(\/usr)?\/s?bin\/(nologin|false)$/) print("account " name ": shell " shell " allows a login")
                # "x" defers to the shadow entry; with none there is no password to log in with.
                if (pw == "x") pw = shadowed ? spw : "*"
                if (pw !~ /^[!*]/) print("account " name ": the password is not locked")
                if (home != "/" && home != "/nonexistent" && home != "/var/lib/iron-vault")
                    print("account " name ": home " home " is not /, /nonexistent or /var/lib/iron-vault")
                if (!grp || gid != ggid) print("account " name ": the primary group is not " name)
                for (i = 1; i <= groups; i++) if (index(gmembers[i], "," name ",")) print("account " name ": member of group " gname[i])
                for (i = 1; i <= users; i++) if (puid[i] == uid) print("account " pname[i] ": has the same uid as " name)
            }
            if (grp) {
                if (members != "") print("group " name ": lists members " members)
                # The gshadow member list can differ from the one in /etc/group, and either makes the group joinable.
                if (gadmins != "") print("group " name ": gshadow names administrators " gadmins)
                if (gpw) print("group " name ": gshadow sets a group password")
                # newgrp(1) reads the password from gshadow when it has an entry for the group, and from /etc/group otherwise.
                # "x" there points at gshadow, so with no entry it is no password anyone can match.
                if (!gshadowed && gpw_group != "" && gpw_group != "x" && gpw_group !~ /^[!*]/)
                    print("group " name ": /etc/group sets a group password")
                if (gmembers_sh != "") print("group " name ": gshadow lists members " gmembers_sh)
                for (i = 1; i <= users; i++) if (pgid[i] == ggid) print("group " name ": primary group of account " pname[i])
                for (i = 1; i <= groups; i++) if (ggidof[i] == ggid) print("group " gname[i] ": has the same gid as " name)
            }
        }' "$@"
}

# Fails configure, saying what is wrong and how to fix it, when service_account_problems finds anything.
refuse_unsafe_service_account() {
    if ! problems=$(service_account_problems); then
        echo "iron-vault: could not check the account files for an existing iron-vault account" >&2
        echo "iron-vault: check that $passwd_file, $group_file, $shadow_file and $gshadow_file are readable," \
            "then run 'sudo dpkg --configure iron-vault'." >&2
        return 1
    fi
    [ -n "$problems" ] || return 0
    {
        echo "iron-vault: an iron-vault account or group already exists and is not a locked system account:"
        printf '%s\n' "$problems" | sed 's/^/iron-vault:   /'
        echo "iron-vault: correct it, or delete it ('userdel iron-vault', then 'groupdel iron-vault' if the group remains)"
        echo "iron-vault: so the package creates its own; then run 'sudo dpkg --configure iron-vault'."
    } >&2
    return 1
}

# END service account check.

# Registers the purge question's template with debconf; the question itself is asked by postrm.
# shellcheck source=/dev/null
[ -e /usr/share/debconf/confmodule ] && . /usr/share/debconf/confmodule

# Only on the first configure, or the first after a purge: an account that exists then was not made by this package.
# Later configures keep the account the package made, whose group may hold a log collector's account.
if [ "$1" = configure ] && [ -z "$2" ]; then
    passwd_file=/etc/passwd group_file=/etc/group shadow_file=/etc/shadow gshadow_file=/etc/gshadow login_defs=/etc/login.defs
    refuse_unsafe_service_account || exit 1
fi

# The generated snippets create the account and directories before they enable and start the service.
#DEBHELPER#

# cargo-deb generates snippets for iron-vault.service only, so the TPM signing helper's socket is enabled and started here, in the
# form dh_installsystemd uses for a unit enabled by default: `was-enabled` is true on a fresh install (no state file yet) and false
# once an administrator has disabled the socket, so an upgrade keeps it disabled. The socket listens on a machine with no TPM too;
# the helper instance then fails to start and `approver add --kind tpm` says the helper is unavailable.
tpm_socket=iron-vault-tpm-signer.socket
case "$1" in
    configure | abort-upgrade | abort-deconfigure | abort-remove)
        deb-systemd-helper unmask "$tpm_socket" >/dev/null || true
        if deb-systemd-helper --quiet was-enabled "$tpm_socket"; then
            deb-systemd-helper enable "$tpm_socket" >/dev/null || true
        else
            deb-systemd-helper update-state "$tpm_socket" >/dev/null || true
        fi
        if [ -d /run/systemd/system ]; then
            deb-systemd-invoke start "$tpm_socket" >/dev/null || true
        fi
        ;;
esac

if [ "$1" = configure ]; then
    if [ -z "$2" ]; then
        next="sudo iron-vault init"
    else
        next="sudo iron-vault unlock"
    fi
    echo "iron-vault: the service is Locked until you run '$next'." >&2
fi

exit 0
